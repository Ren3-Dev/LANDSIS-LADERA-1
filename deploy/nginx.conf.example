# Instalar como sitio de Nginx, no como nginx.conf global.
# Sustituir YOUR_DOMAIN y rutas de certificados DESPUÉS de emitirlos.
# No publicar antes de validar nginx -t, TLS y autenticación.
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;
    # Nunca redirigir un POST con un secreto recibido por HTTP.
    location ~* ^/api(?:/|$) { return 403; }
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 308 https://YOUR_DOMAIN$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name YOUR_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/landsis/current/frontend/dist;
    index index.html;

    # Recepción cerrada por defecto, incluidas variantes de mayúsculas y subrutas.
    # Quitar SOLO limit_except después de aceptación privada de TLS y token.
    location ~* ^/api/v1/readings(?:/|$) {
        limit_except GET HEAD { deny all; }
        include /etc/nginx/snippets/landsis-api.conf;
    }
    location /api/ {
        include /etc/nginx/snippets/landsis-api.conf;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
