# Copiar fuera del repositorio a /etc/landsis/backend.env, root:root 0600.
NODE_ENV=production
LANDSIS_HOST=127.0.0.1
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=landsis
PGUSER=
PGPASSWORD=
IOT_NODE_ID=LADERA-1
# Generar y configurar privadamente; sin valor el servicio no arranca.
IOT_DEVICE_TOKEN=
# Conservar la configuración privada existente de correo si se utiliza.
RECOVERY_EMAIL_ENABLED=false
ALERT_EMAIL_ENABLED=false
FRONTEND_URL=https://YOUR_DOMAIN/
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
