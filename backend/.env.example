PORT=3000

# development: cookie local HTTP; production: cookie Secure, requiere HTTPS.
# Sesiones opacas en memoria; no requieren secreto JWT.
NODE_ENV=development

# Conexión local a una base landsis ya creada.
# Configurar PGUSER y PGPASSWORD únicamente en el entorno local.
PGHOST=localhost
PGPORT=5432
PGDATABASE=landsis
PGUSER=
# Solo necesario si la autenticación de PostgreSQL requiere contraseña.
PGPASSWORD=

# Correo de recuperación: habilitar explícitamente después de aplicar 005.
RECOVERY_EMAIL_ENABLED=false
# Base del frontend, sin query, fragmento ni credenciales. HTTPS en producción.
# Vista existente: /reset-password#token=...
FRONTEND_URL=http://127.0.0.1:5173/
# Gmail: TLS implícito y contraseña de aplicación de Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Una dirección simple autorizada por el proveedor (sin nombre ni lista).
MAIL_FROM=

# Avisos individuales por CRITICO de inclinacion 6/6; requiere migracion 007.
ALERT_EMAIL_ENABLED=false
